  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Средняя интенсивность трафика по датчикам",
      "description": "Среднее значение транспортного потока в машинах в час для каждого датчика.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "traffic_clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "traffic_clickhouse"
          },
          "queryType": "time_series",
          "rawSql": "SELECT\n    window_start AS time,\n    concat('sensor_', toString(sensor_id)) AS metric,\n    avg_cars_per_hour AS value\nFROM traffic_db.traffic_window_aggregates\nWHERE $__timeFilter(window_start)\n  AND sensor_id IN (3, 4, 5)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Локальный тренд транспортной нагрузки",
      "description": "Коэффициент наклона локальной линейной регрессии внутри каждого часового окна. Положительное значение означает рост потока, отрицательное — снижение.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "traffic_clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "traffic_clickhouse"
          },
          "queryType": "time_series",
          "rawSql": "SELECT\n    window_start AS time,\n    concat('sensor_', toString(sensor_id)) AS metric,\n    slope_per_second AS value\nFROM traffic_db.traffic_local_regression\nWHERE $__timeFilter(window_start)\n  AND sensor_id IN (3, 4, 5)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Качество локальной линейной аппроксимации",
      "description": "R² показывает, насколько хорошо локальная линейная регрессия описывает значения трафика внутри часового окна.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "traffic_clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "traffic_clickhouse"
          },
          "queryType": "time_series",
          "rawSql": "SELECT\n    window_start AS time,\n    concat('sensor_', toString(sensor_id)) AS metric,\n    r2_score AS value\nFROM traffic_db.traffic_local_regression\nWHERE $__timeFilter(window_start)\n  AND sensor_id IN (3, 4, 5)\nORDER BY time",
          "refId": "A"
        }
      ],
      "fieldConfig": {
