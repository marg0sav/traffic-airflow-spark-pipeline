        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Распределение окон по типам тренда",
      "description": "Количество часовых окон, классифицированных как growing, falling или stable.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "traffic_clickhouse"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "traffic_clickhouse"
          },
          "queryType": "table",
          "rawSql": "SELECT\n    trend_label,\n    count() AS windows_count\nFROM traffic_db.traffic_local_regression\nWHERE sensor_id IN (3, 4, 5)\nGROUP BY trend_label\nORDER BY windows_count DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {
